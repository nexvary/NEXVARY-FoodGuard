    <string name="looks_normal">Looks visually normal</string>
    <string name="ripe">Ripe</string>
    <string name="caution">Caution</string>
    <string name="danger">Discard</string>
    <string name="mango_normal_desc">Healthy flesh is usually yellow to deep orange, with a sweet aroma and soft but coherent texture. A darker orange center alone does not mean spoilage.</string>
    <string name="mango_spoilage_title">Visible spoilage signs</string>
    <string name="mango_spoilage_desc">Watch for black or brown mushy areas, slime, leaking fluid, mold, a sharp fermented or alcoholic smell, or an unusually sour taste.</string>
    <string name="storage">Storage</string>
    <string name="storage_desc">Ripen whole mangoes at room temperature. Refrigerate once ripe. Keep cut mango chilled in a clean sealed container.</string>
    <string name="safety_note">Images cannot prove microbiological safety. When storage history or smell suggests danger, discard the food.</string>
